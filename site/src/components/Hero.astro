---
import { links } from '../links';

const facts = [
  'Leaderless DAG',
  'Objects up to 4 KB',
  'Four host functions',
  'Ten holders minimum',
];
---

<section class="hero" id="top">
  <div class="wrap hero-inner">
    <h1>A backend the network runs, stores, and never rolls back.</h1>

    <div class="hero-foot">
      <p class="lede">
        Backends run as WebAssembly modules called pods. State splits into objects, each
        held by a handful of validators, so a transaction runs on the ten or fifty machines
        that hold what it touches instead of on every machine in the network.
      </p>

      <nav class="entries" aria-label="Read more">
        <a class="entry entry--lead" href={links.whitepaper} rel="noopener">
          Read the whitepaper<span class="arrow" aria-hidden="true">&#8627;</span>
        </a>
      </nav>
    </div>

    <ul class="facts">
      {facts.map((fact) => <li>{fact}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding-block: 9rem 3.5rem;
    background:
      radial-gradient(110% 70% at 50% -18%, rgba(111, 29, 27, 0.9), rgba(111, 29, 27, 0) 62%),
      radial-gradient(96% 64% at 44% 20%, rgba(173, 189, 171, 0.66), transparent 66%),
      var(--linen);
  }

  .hero-inner {
    width: min(100% - 2 * clamp(1.5rem, 4vw, 3.5rem), 1240px);
  }

  h1 {
    max-width: 15ch;
  }

  .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    flex-wrap: wrap;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* Read as two lines of a contents page: a rule, a title, a folio arrow. */
  .entries {
    width: min(100%, 24rem);
  }

  .entry {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.7rem 0.6rem;
    border-top: 1px solid var(--ink);
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .entry:last-child {
    border-bottom: 1px solid var(--ink);
  }

  .entry--lead {
    font-size: 1.5rem;
  }

  .entry:hover {
    color: var(--wine);
  }

  .arrow {
    flex: none;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entry:hover .arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .entry:hover .arrow {
      transition: none;
      transform: none;
    }
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: clamp(3rem, 7vw, 5.5rem) 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
    font-family: var(--mono);
    font-size: var(--step-meta);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  @media (max-width: 720px) {
    .hero {
      padding-block: 7.5rem 2.5rem;
    }

    h1 {
      max-width: none;
    }
  }
</style>
