---
import { links } from '../links';

const parts = [
  {
    title: 'Objects',
    body: 'The global state is not a tree. It is a set of discrete objects, each carrying an ID, a version, an owner, a replication factor, and up to 4 KB of content. Two transactions touching different objects can never collide, and when they touch the same one, catching it is a version check rather than a lock.',
    meta: 'id · version · owner · replication · content',
  },
  {
    title: 'Consensus',
    body: 'Ordering runs on a leaderless DAG. Every validator produces one vertex per round, linking to a stake supermajority of the round before, so there is no proposer to wait on and none to bribe. Committing an anchor applies its whole causal history in an order that is a pure function of the hash links, identical on every node.',
    meta: 'one vertex per validator per round',
  },
  {
    title: 'Pods',
    body: 'Backends are Rust compiled to WebAssembly and run in wazero. The sandbox exposes four host functions and nothing else: declare gas, ask for the input size, read the input, write the output. No filesystem, no network, no clock. That is the entire attack surface.',
    meta: 'gas · input_len · read_input · write_output',
  },
];
---

<section class="band" id="mechanics">
  <div class="wrap reveal">
    <div class="head">
      <div>
        <h2>Three pieces do most of the work.</h2>
      </div>
      <a class="jump" href={links.whitepaper} rel="noopener">Full whitepaper &#8627;</a>
    </div>

    <div class="grid grid--3">
      {
        parts.map((part) => (
          <article class="card">
            <h3>{part.title}</h3>
            <p>{part.body}</p>
            <p class="meta">{part.meta}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
