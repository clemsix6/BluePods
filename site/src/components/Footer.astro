---
import { author, links } from '../links';

const columns = [
  {
    title: 'Documents',
    items: [
      { label: 'Whitepaper', href: links.whitepaper },
      { label: 'Vision', href: links.vision },
    ],
  },
];
---

<footer class="band foot">
  <div class="wrap foot-inner">
    <div>
      <p class="mark">BluePods</p>
      <p class="tag">A decentralized cloud, written from scratch.</p>

      <p class="byline">
        Designed and built by <a class="who" href={links.author} rel="noopener me">{author}</a>
      </p>

      <p class="legal">Apache License 2.0</p>
    </div>

    <div class="cols">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
                      <p class="col-title">{column.title}</p>
            <ul>
              {column.items.map((item) => (
                <li>
                  <a href={item.href} rel="noopener">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .foot-inner {
    display: flex;
    justify-content: space-between;
    gap: 3rem clamp(2rem, 6vw, 6rem);
    flex-wrap: wrap;
  }

  .mark {
    font-family: var(--display);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .tag {
    max-width: 32ch;
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .byline {
    margin-top: 1.1rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  /* Set at reading size rather than in the footer's mono link register, so the
     name reads as a byline and not as one more entry in a list of links. */
  .who {
    font-family: var(--sans);
    font-size: inherit;
    letter-spacing: normal;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 1px;
    border-bottom: 1px solid var(--rule);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .who:hover {
    color: var(--wine);
    border-color: var(--wine);
  }

  .legal {
    margin-top: 2.5rem;
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .cols {
    display: flex;
    gap: clamp(2.5rem, 6vw, 5rem);
    flex-wrap: wrap;
  }

  .col-title {
    margin-bottom: 1.25rem;
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    font-family: var(--mono);
    font-size: var(--step-meta);
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.25s ease;
  }

  a:hover {
    color: var(--wine);
  }
</style>
