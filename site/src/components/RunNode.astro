---
import { Code } from 'astro:components';
import { codeTheme } from '../codeTheme';
import { links } from '../links';

const build = `cd pods/pod-system && make release && cd ../..
go build -o node ./cmd/node
go build -o bpctl ./cmd/cli`;

const cluster = `./node -bootstrap -quic 127.0.0.1:9000 -data ./data1
./node -bootstrap-addr 127.0.0.1:9000 -quic 127.0.0.1:9001 -data ./data2
./node -bootstrap-addr 127.0.0.1:9000 -quic 127.0.0.1:9002 -data ./data3`;
---

<section class="band" id="run">
  <div class="wrap reveal">
    <div class="head">
      <div>
        <p class="label">Running it</p>
        <h2>Three terminals is a network.</h2>
      </div>
      <a class="jump" href={links.testing} rel="noopener">Scenario harness &#8627;</a>
    </div>

    <div class="run-grid">
      <div class="run-step">
        <p class="step-label">Build</p>
        <Code code={build} lang="bash" theme={codeTheme} />
        <p class="note">
          Go 1.26 and the Rust WebAssembly target. Building the pod also compiles the gas
          instrumenter and stitches metering into the deployed module.
        </p>
      </div>

      <div class="run-step">
        <p class="step-label">Bring up a cluster</p>
        <Code code={cluster} lang="bash" theme={codeTheme} />
        <p class="note">
          One bootstrap node and as many joiners as you want. On a terminal each node draws
          a live dashboard: round, transactions per second, peers, committed transactions.
        </p>
      </div>
    </div>

    <p class="closing">
      The network speaks QUIC rather than HTTP, so you reach it through
      <span class="code">bpctl</span>. Give it no command and it opens an interactive console
      where balances and transaction statuses update in place.
    </p>
  </div>
</section>

<style>
  .run-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .step-label {
    margin-bottom: 1rem;
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .note {
    max-width: 46ch;
    margin-top: 1.1rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .closing {
    max-width: 58ch;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
  }

  .code {
    font-family: var(--mono);
    font-size: 0.88em;
    color: var(--wine);
  }

  @media (max-width: 900px) {
    .run-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
