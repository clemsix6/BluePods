---
const guarantees = [
  {
    title: 'Zero rollback',
    body: 'A finalized operation is never reverted. Finality is deterministic and absolute, not probabilistic. The committed log is append-only, so a backend can treat a finalized write as permanent and build on it without defensive logic.',
  },
  {
    title: 'Holder-independent atomicity',
    body: 'A transaction touches every object it declares, up to the reference cap, atomically and consistently in one finalized step, whichever validators hold them. The atomic boundary is the transaction, never a chain: across transactions the client orchestrates, and zero rollback makes each finalized step solid ground that needs no compensating logic.',
  },
];
---

<section class="band" id="guarantees">
  <div class="wrap reveal">
    <div class="head">
      <div>
        <h2>Neither of these bends.</h2>
      </div>
      <p class="aside">
        They are what make a decentralized cloud usable rather than merely possible.
      </p>
    </div>

    <div class="grid grid--2">
      {
        guarantees.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .aside {
    max-width: 30ch;
    padding-bottom: 0.5rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }
</style>
